---
/** Card sede: indirizzo, orari, mezzi, parcheggio, azioni e mappa a due click */
import Icon from './Icon.astro';
import Todo from './Todo.astro';
import MapTwoClick from './MapTwoClick.astro';
import { site, telHref, indicazioniHref, type Sede } from '../data/site';

interface Props {
  sede: Sede;
  link?: boolean;
  headingLevel?: 'h2' | 'h3';
}
const { sede, link = true, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
---

<article class="card sede">
  <div class="sede__info">
    <H class="h3 sede__name">
      {link ? <a class="link-plain" href={`/sedi/${sede.slug}/`}>{sede.nome}</a> : sede.nome}
    </H>
    <dl class="sede__list">
      <div>
        <dt><Icon name="pin" /> Indirizzo</dt>
        <dd>
          {sede.indirizzo}, {sede.cap} {sede.citta} ({sede.zona})
          {!sede.capConfermato && (
            <>
              <br />
              <Todo note={sede.capNota} />
            </>
          )}
        </dd>
      </div>
      <div>
        <dt><Icon name="clock" /> Segreteria e teoria</dt>
        <dd>
          <ul role="list" class="sede__hours">
            {site.orari.righe.map((r) => (
              <li>
                <strong>{r.giorni}</strong>{' '}
                {r.confermato ? r.fasce.join(' e ') : <Todo note={r.nota ? `orari (${r.nota})` : 'orari'} />}
              </li>
            ))}
          </ul>
        </dd>
      </div>
      <div>
        <dt><Icon name="transit" /> Mezzi pubblici</dt>
        <dd>{sede.mezzi || <Todo note="linee di mezzi pubblici vicine" />}</dd>
      </div>
      <div>
        <dt><Icon name="parking" /> Parcheggio</dt>
        <dd>{sede.parcheggio || <Todo note="informazioni sul parcheggio" />}</dd>
      </div>
    </dl>
    <div class="btn-row">
      <a class="btn" href={indicazioniHref(sede)} target="_blank" rel="noopener">
        <Icon name="route" /> Indicazioni <span class="sr-only">(si apre in una nuova scheda)</span>
      </a>
      <a class="btn btn--white" href={telHref}><Icon name="phone" /> Chiama</a>
    </div>
  </div>
  <div class="sede__map">
    <MapTwoClick sede={sede} />
  </div>
</article>

<style>
  .sede {
    display: grid;
    gap: var(--space-6);
    padding: clamp(1.25rem, 1rem + 1.5vw, 2.5rem);
    border-radius: var(--radius-xl);
  }
  .sede__name {
    font-size: clamp(1.75rem, 1.4rem + 1.5vw, 2.5rem);
    margin-bottom: var(--space-5);
  }
  .link-plain {
    color: inherit;
    text-decoration-thickness: 3px;
    text-underline-offset: 5px;
    text-decoration-color: var(--lime);
  }
  .sede__list {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }
  .sede__list dt {
    display: flex;
    align-items: center;
    gap: 0.45em;
    font-weight: 800;
    font-size: var(--fs-small);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .sede__list dt :global(.icon) {
    width: 1.3em;
    height: 1.3em;
    color: var(--forest);
  }
  .sede__list dd {
    margin: 0.25rem 0 0 calc(1.3em + 0.45em);
  }
  .sede__hours {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.2rem;
  }
  @media (min-width: 900px) {
    .sede {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }
</style>
