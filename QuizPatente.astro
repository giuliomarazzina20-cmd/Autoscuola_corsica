---
/**
 * Strumento 1 · "Quale patente fa per te?"
 * Regole lette SOLO da site.requisiti. Se è vuoto lo strumento non viene mostrato.
 */
import Icon from '../Icon.astro';
import { site } from '../../data/site';

interface Props {
  bg?: 'cream' | 'forest' | 'lime' | 'ink';
}
const { bg = 'forest' } = Astro.props;

const req = site.requisiti.filter((r) => site.patenti.some((p) => p.slug === r.patente));
const show = req.length > 0;

// Fasce d'età costruite dalle età minime confermate
const eta = [...new Set(req.map((r) => r.etaMinima))].sort((a, b) => a - b);
const fasce = [
  ...(eta[0] > 0 ? [{ value: 0, label: `Meno di ${eta[0]} anni` }] : []),
  ...eta.map((e, i) => ({
    value: e,
    label: i < eta.length - 1 ? (eta[i + 1] - 1 === e ? `${e} anni` : `${e}–${eta[i + 1] - 1} anni`) : `${e} anni o più`,
  })),
];
const veicoli = site.veicoliQuiz.filter((v) => req.some((r) => r.veicolo === v.id));
const data = {
  requisiti: req,
  patenti: Object.fromEntries(site.patenti.map((p) => [p.slug, { codice: p.codice, veicolo: p.veicolo }])),
  veicoli: Object.fromEntries(site.veicoliQuiz.map((v) => [v.id, v.label])),
};
---

{
  show && (
    <section class:list={['section', `bg-${bg}`, 'tool']} id="quale-patente" aria-labelledby="quiz-title">
      <div class="container">
        <div class="section__head">
          <p class="eyebrow muted">
            <Icon name="spark" /> Strumento
          </p>
          <h2 class="h2" id="quiz-title">
            Quale patente fa <span class="hl">per te</span>?
          </h2>
          <p class="lead muted">Tre domande, una risposta. Tutto resta sul tuo telefono: nessun dato viene inviato.</p>
        </div>

        <form class="card tool__card" data-quiz novalidate>
          <fieldset class="choices">
            <legend>1. Quanti anni hai?</legend>
            {fasce.map((f) => (
              <label class="choice">
                <input type="radio" name="eta" value={f.value} required />
                {f.label}
              </label>
            ))}
          </fieldset>
          <fieldset class="choices">
            <legend>2. Cosa vuoi guidare?</legend>
            {veicoli.map((v) => (
              <label class="choice">
                <input type="radio" name="veicolo" value={v.id} required />
                {v.label}
              </label>
            ))}
          </fieldset>
          <fieldset class="choices">
            <legend>3. Ti serve per lavoro?</legend>
            <label class="choice">
              <input type="radio" name="lavoro" value="si" required />
              Sì
            </label>
            <label class="choice">
              <input type="radio" name="lavoro" value="no" required />
              No
            </label>
          </fieldset>
          <div>
            <button type="submit" class="btn btn--ink btn--lg">
              Scopri la tua patente <Icon name="arrow-right" />
            </button>
          </div>
          <div class="tool__result" data-quiz-result role="status" aria-live="polite" tabindex="-1" />
        </form>
        <script type="application/json" data-quiz-data set:html={JSON.stringify(data)} />
      </div>
    </section>
  )
}

<script>
  import { readJson } from '../../scripts/wa';

  type Req = { patente: string; etaMinima: number; veicolo: string; lavoro: boolean };
  type Data = {
    requisiti: Req[];
    patenti: Record<string, { codice: string; veicolo: string }>;
    veicoli: Record<string, string>;
  };

  document.querySelectorAll<HTMLFormElement>('[data-quiz]').forEach((form) => {
    const data = readJson<Data>(form.parentElement!, '[data-quiz-data]');
    const out = form.querySelector<HTMLElement>('[data-quiz-result]')!;
    if (!data) return;

    const el = (tag: string, text?: string, cls?: string) => {
      const n = document.createElement(tag);
      if (text) n.textContent = text;
      if (cls) n.className = cls;
      return n;
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const eta = fd.get('eta');
      const veicolo = fd.get('veicolo');
      const lavoro = fd.get('lavoro');
      out.replaceChildren();
      out.dataset.state = '';

      if (eta === null || veicolo === null || lavoro === null) {
        out.dataset.state = 'error';
        out.append(el('p', 'Rispondi a tutte e tre le domande per vedere il risultato.'));
        out.focus();
        return;
      }

      const age = Number(eta);
      const candidates = data.requisiti.filter((r) => r.veicolo === veicolo);
      const eligible = candidates.filter((r) => age >= r.etaMinima);

      if (!eligible.length) {
        const min = Math.min(...candidates.map((r) => r.etaMinima));
        const first = candidates.find((r) => r.etaMinima === min)!;
        out.append(
          el('p', 'Ancora un po’ di pazienza', 'tool__kicker'),
          el('p', `Per guidare ${String(data.veicoli[String(veicolo)]).toLowerCase()} serve avere almeno ${min} anni: è la patente ${data.patenti[first.patente].codice}.`),
        );
      } else {
        const wantsWork = lavoro === 'si';
        const pool = eligible.filter((r) => r.lavoro === wantsWork);
        const list = pool.length ? pool : eligible;
        const pick = list.reduce((a, b) => (b.etaMinima > a.etaMinima ? b : a));
        const p = data.patenti[pick.patente];
        const a = el('a', `Scopri la patente ${p.codice}`, 'btn btn--ink') as HTMLAnchorElement;
        a.href = `/patenti/${pick.patente}/`;
        out.dataset.state = 'ok';
        out.append(
          el('p', 'La nostra proposta', 'tool__kicker'),
          el('p', `Patente ${p.codice}`, 'tool__big'),
          el('p', `${p.veicolo}. Indicazione orientativa: la confermiamo insieme in sede.`),
          a,
        );
      }
      out.focus();
    });
  });
</script>
