---
/** FAQ ad accordion con <details> nativi */
import Icon from './Icon.astro';
import { site } from '../data/site';
import { withTodo } from '../lib/text';

interface Props {
  items?: { domanda: string; risposta: string }[];
  heading?: boolean;
  bg?: 'cream' | 'white' | 'lime';
}
const { items = site.faq, heading = true, bg = 'cream' } = Astro.props;
---

<section class:list={['section', `bg-${bg}`]} aria-labelledby="faq-title">
  <div class="container faq">
    {
      heading ? (
        <div class="section__head">
          <p class="eyebrow muted">FAQ</p>
          <h2 class="h2" id="faq-title">
            Hai dubbi? <span class="hl">Chiedi</span> pure
          </h2>
        </div>
      ) : (
        <h2 class="sr-only" id="faq-title">
          Domande e risposte
        </h2>
      )
    }
    <div class="faq__list">
      {
        items.map((f) => (
          <details class="faq__item">
            <summary>
              <span>{f.domanda}</span>
              <span class="faq__sign" aria-hidden="true">
                <Icon name="plus" />
              </span>
            </summary>
            <p set:html={withTodo(f.risposta)} />
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq__list {
    display: grid;
    gap: var(--space-3);
    max-width: 52rem;
  }
  .faq__item {
    background: var(--white);
    color: var(--ink);
    border: var(--border);
    border-radius: var(--radius-md);
    transition: transform var(--dur) var(--ease-out);
  }
  .faq__item[open] {
    box-shadow: var(--shadow-btn);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 60px;
    padding: var(--space-3) var(--space-5);
    font-weight: 800;
    font-size: 1.125rem;
    line-height: 1.3;
    cursor: pointer;
    list-style: none;
    border-radius: inherit;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .faq__sign {
    display: grid;
    place-items: center;
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--lime);
    border: var(--border);
    transition: transform var(--dur) var(--ease-out);
  }
  .faq__sign :global(.icon) {
    width: 20px;
    height: 20px;
  }
  .faq__item[open] .faq__sign {
    transform: rotate(45deg);
  }
  .faq__item p {
    padding: 0 var(--space-5) var(--space-5);
    max-width: 44rem;
  }
</style>
